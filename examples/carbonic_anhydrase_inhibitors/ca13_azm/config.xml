<?xml version="1.0" ?>
<config>
  <structure>
    <ligand_source>rcsb_smiles</ligand_source>                                             <!-- Source of the receptor and ligand structures. Options: prmtop, complex_pdb, rcsb, and rcsb_smiles. -->
    <pdb_id>3CZV</pdb_id>                                                                  <!-- RCSB entry to download. -->
    <ligand_resid>AZM</ligand_resid>                                                       <!-- Residue name of the ligand within the RCSB entry. -->
    <smiles>CC(=O)NC1=NN=C(S1)S([NH-])(=O)=O</smiles>                                      <!-- Ligand SMILES, used in place of the deposited coordinates. -->
    <chain>A</chain>                                                                       <!-- Receptor chain retained. Blank retains all chains. -->
    <ligand_net_charge>-1</ligand_net_charge>                                              <!-- Formal charge of the ligand. Blank defers to OpenEye. -->
    <keep_hetatm>                                                                          <!-- Het groups retained with the receptor. -->
      <item>ZN</item>
    </keep_hetatm>
  </structure>
  <names>
    <ligand_formula>C4 H5 N4 O3 S2</ligand_formula>                                        <!-- Ligand composition. The build aborts on a mismatch. -->
    <receptor_resname>CA13</receptor_resname>                                              <!-- Receptor label written to input.xml. -->
    <ligand_resname>AZM</ligand_resname>                                                   <!-- Ligand label written to input.xml. -->
  </names>
  <criterion>
    <mode>explicit</mode>                                                                  <!-- Reaction criterion. Options: auto and explicit. -->
    <receptor>                                                                             <!-- Receptor side of each pair. The pair counts when this atom is within the cutoff of its ligand atom. -->
      <target resid="196" atom="OG1" resname="THR"/>
      <target resid="91" atom="NE2" resname="HIE"/>
      <target resid="93" atom="NE2" resname="HIE"/>
      <target resid="116" atom="ND1" resname="HIE"/>
    </receptor>
    <ligand>                                                                               <!-- Ligand side of each pair. Use auto to choose the nearest atom that atom_filter permits. -->
      <atom name="N3"/>
      <atom name="N3"/>
      <atom name="N3"/>
      <atom name="N3"/>
    </ligand>
    <cutoffs>                                                                              <!-- Distance defining each pair (in angstroms) in the same order as receptor. -->
      <item>2.5</item>
      <item>2.5</item>
      <item>2.5</item>
      <item>2.5</item>
    </cutoffs>
    <n_needed>2</n_needed>                                                                 <!-- Pairs that must be inside their cutoff at once for a trajectory to count as reacted. -->
  </criterion>
  <run>
    <bd_milestone_radius>60.0</bd_milestone_radius>                                        <!-- Radius of the starting sphere (in angstroms). -->
    <n_trajectories>5000000</n_trajectories>                                               <!-- Number of Brownian dynamics trajectories. -->
    <apbs_fglen>128</apbs_fglen>                                                           <!-- Fine electrostatic grid length (in angstroms). 0 derives it. -->
    <apbs_dime>257</apbs_dime>                                                             <!-- Grid points per axis of the electrostatic grid. -->
    <apbs_cglen>0</apbs_cglen>                                                             <!-- Coarse electrostatic grid length (in angstroms). 0 derives it. -->
    <apbs_coarse_dime>0</apbs_coarse_dime>                                                 <!-- Grid points per axis of the coarse grid. 0 uses apbs_dime. -->
    <apbs_fine_dime>0</apbs_fine_dime>                                                     <!-- Grid points per axis of the fine grid. 0 uses apbs_dime. -->
    <debye_length>9.62</debye_length>                                                      <!-- Electrostatic screening length of the salt (in angstroms). -->
    <ion_concentration>0.10</ion_concentration>                                            <!-- Salt concentration (in molar). -->
    <ion_radius_pos>0.95</ion_radius_pos>                                                  <!-- Radius of the positive ion (in angstroms). -->
    <ion_radius_neg>1.81</ion_radius_neg>                                                  <!-- Radius of the negative ion (in angstroms). -->
    <pdie>4.0</pdie>                                                                       <!-- Dielectric constant of the protein. -->
    <sdie>78.0</sdie>                                                                      <!-- Dielectric constant of the solvent. -->
    <srad>1.4</srad>                                                                       <!-- Solvent probe radius (in angstroms). -->
    <desolvation_alpha>1.0</desolvation_alpha>                                             <!-- Scaling applied to the desolvation penalty. -->
    <enable_born2_torque>false</enable_born2_torque>                                       <!-- Include the reciprocal desolvation torque on the receptor. Options: true and false. -->
    <hydrodynamic_interactions>true</hydrodynamic_interactions>                            <!-- Include hydrodynamic coupling between the two molecules. Options: true and false. -->
    <multipole_fallback>true</multipole_fallback>                                          <!-- Extend the electrostatics beyond the grid by multipole expansion. Options: true and false. -->
    <lj_forces>false</lj_forces>                                                           <!-- Implement repulsive forces at close contact. Options: true and false. -->
    <overlap_check>false</overlap_check>                                                   <!-- Stop the ligand from entering the receptor volume. Options: true and false. -->
    <gpu_force_batch>1000</gpu_force_batch>                                                <!-- Trajectories per GPU force evaluation. 0 selects automatically. -->
    <max_steps>10000000</max_steps>                                                        <!-- Step limit per trajectory. -->
    <dt>0.2</dt>                                                                           <!-- Largest permitted time step (in picoseconds). -->
    <minimum_core_dt>0.2</minimum_core_dt>                                                 <!-- Smallest permitted time step. 0 imposes no floor. -->
    <max_dt>0</max_dt>                                                                     <!-- Ceiling on the time step. 0 imposes no ceiling. -->
    <r_hydro_rec>0</r_hydro_rec>                                                           <!-- Receptor hydrodynamic radius. 0 derives it from the PQR. -->
    <r_hydro_lig>0</r_hydro_lig>                                                           <!-- Ligand hydrodynamic radius. 0 derives it from the PQR file. -->
    <temperature>298.15</temperature>                                                      <!-- Temperature (in kelvin). -->
    <seed>1</seed>                                                                         <!-- Random number seed. -->
    <gpu>true</gpu>                                                                        <!-- Evaluate forces on the GPU. Options: true and false. -->
    <n_threads>32</n_threads>                                                              <!-- Number of CPU threads. -->
    <convergence_check>true</convergence_check>                                            <!-- Run convergence analysis after the simulation. Options: true and false. -->
    <convergence_interval>10</convergence_interval>                                        <!-- Reporting interval for the running rate. -->
    <convergence_tol>0.05</convergence_tol>                                                <!-- Relative error defining convergence. -->
    <checkpoint_interval>0</checkpoint_interval>                                           <!-- Trajectories between checkpoints. 0 disables checkpointing. -->
    <save_interval>10</save_interval>                                                      <!-- Steps between saved positions. 0 saves endpoints only. -->
  </run>
</config>
